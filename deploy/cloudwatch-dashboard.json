{
  "widgets": [
    {"type": "text", "x": 0, "y": 0, "width": 24, "height": 2,
     "properties": {"markdown": "# NetGuard Cloud\nNetwork intrusion & anomaly detection: traffic analysed, threats found, pipeline health. App logs: `/netguard/web`, sensor logs: `/netguard/log-streamer`."}},
    {"type": "metric", "x": 0, "y": 2, "width": 12, "height": 6,
     "properties": {"title": "Connections analysed by verdict", "region": "__REGION__", "stat": "Sum", "period": 60, "view": "timeSeries", "stacked": true,
       "metrics": [["__NS__", "NormalTraffic", {"color": "#0ca30c", "label": "Normal"}],
                   [".", "Suspicious", {"color": "#fab219"}],
                   [".", "Attacks", {"color": "#d03b3b"}]]}},
    {"type": "metric", "x": 12, "y": 2, "width": 12, "height": 6,
     "properties": {"title": "Attacks by type", "region": "__REGION__", "stat": "Sum", "period": 60, "view": "timeSeries", "stacked": true,
       "metrics": [["__NS__", "AttacksByType", "AttackType", "DoS"], ["...", "Probe"], ["...", "R2L"], ["...", "U2R"]]}},
    {"type": "metric", "x": 0, "y": 8, "width": 6, "height": 4,
     "properties": {"title": "Attacks (last hour)", "region": "__REGION__", "stat": "Sum", "period": 3600, "view": "singleValue",
       "metrics": [["__NS__", "Attacks"], [".", "Suspicious"], [".", "RecordsAnalyzed"]]}},
    {"type": "metric", "x": 6, "y": 8, "width": 6, "height": 4,
     "properties": {"title": "Processing latency (ms)", "region": "__REGION__", "period": 60, "view": "timeSeries",
       "metrics": [["__NS__", "ProcessingLatency", {"stat": "Average"}], ["...", {"stat": "Maximum"}]]}},
    {"type": "metric", "x": 12, "y": 8, "width": 6, "height": 4,
     "properties": {"title": "Pipeline: queue & live feeds", "region": "__REGION__", "stat": "Maximum", "period": 60, "view": "timeSeries",
       "metrics": [["__NS__", "QueueDepth"], [".", "ActiveStreams"]]}},
    {"type": "metric", "x": 18, "y": 8, "width": 6, "height": 4,
     "properties": {"title": "Website: requests, sign-ins", "region": "__REGION__", "stat": "Sum", "period": 300, "view": "timeSeries",
       "metrics": [["__NS__", "HttpRequests"], [".", "Logins"], [".", "FailedLogins"], [".", "Signups"], [".", "Http5xx"]]}},
    {"type": "metric", "x": 0, "y": 12, "width": 12, "height": 5,
     "properties": {"title": "Records by source (stream vs uploaded files)", "region": "__REGION__", "stat": "Sum", "period": 300, "view": "timeSeries",
       "metrics": [["__NS__", "RecordsAnalyzed", "Source", "stream"], ["...", "batch"]]}},
    {"type": "metric", "x": 12, "y": 12, "width": 12, "height": 5,
     "properties": {"title": "EC2 instance CPU", "region": "__REGION__", "stat": "Average", "period": 300, "view": "timeSeries",
       "metrics": [["AWS/EC2", "CPUUtilization", "InstanceId", "__INSTANCE__"]]}},
    {"type": "log", "x": 0, "y": 17, "width": 24, "height": 7,
     "properties": {"title": "Latest attacks (CloudWatch Logs Insights)", "region": "__REGION__", "view": "table",
       "query": "SOURCE '/netguard/web' | fields @timestamp, verdict, attack_type, src_ip, service, confidence, anomaly_score, actual_label | filter event = 'detection' | sort @timestamp desc | limit 50"}}
  ]
}
